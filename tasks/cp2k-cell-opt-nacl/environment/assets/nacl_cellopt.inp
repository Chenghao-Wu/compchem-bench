&GLOBAL
  PROJECT nacl_cellopt
  RUN_TYPE CELL_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL
&MOTION
  &CELL_OPT
    TYPE DIRECT_CELL_OPT
    MAX_ITER 100
    OPTIMIZER BFGS
    EXTERNAL_PRESSURE 0.0
  &END CELL_OPT
  &GEO_OPT
    TYPE MINIMIZATION
    MAX_ITER 100
    OPTIMIZER BFGS
  &END GEO_OPT
&END MOTION
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 50
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 5.8 5.8 5.8
    &END CELL
    &COORD
      Na  0.000  0.000  0.000
      Na  0.000  2.900  2.900
      Na  2.900  0.000  2.900
      Na  2.900  2.900  0.000
      Cl  2.900  2.900  2.900
      Cl  2.900  0.000  0.000
      Cl  0.000  2.900  0.000
      Cl  0.000  0.000  2.900
    &END COORD
    &KIND Na
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
