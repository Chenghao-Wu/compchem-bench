# Green-Kubo thermal conductivity of a sticker-functionalized bead-spring melt.
#
# Parameterized input: run it once per temperature with the equilibrated
# initial condition for that state point (data_${suffix}.lammps carries the
# velocities). The value of `suffix` selects the state point:
#
#   lmp_serial -var suffix T1  -in therm.in     # T* = 1.0
#   lmp_serial -var suffix T04 -in therm.in     # T* = 0.4
#
# Do NOT modify this input. The verifier independently recomputes kappa from
# its outputs (J0Jt_${suffix}.dat and flux_${suffix}.dat).

units           lj
atom_style      molecular
boundary        p p p
dimension       3

# --- 1. styles (before read_data: the equilibrated data file carries Bond and
#         Angle Coeffs sections, so LAMMPS needs those styles defined first) --
bond_style      fene
angle_style     cosine
pair_style      hybrid/overlay lj/cut 1.1225 tersoff

# --- 2. equilibrated initial condition (with velocities) ---------------------
read_data       data_${suffix}.lammps

# --- 3. force-field coefficients (box must exist first) ----------------------
special_bonds   fene
bond_coeff      * 30.0 1.5 1.0 1.0
angle_coeff     * 1.5
pair_coeff      * * tersoff bead2.tersoff NULL B1
pair_coeff      * * lj/cut 0.0 1.0 1.1225
pair_coeff      1 * lj/cut 1.0 1.0 1.1225

variable        dt equal 0.005
timestep        ${dt}
neighbor        0.3 bin

thermo          2000
thermo_style    custom step temp ke pe etotal press

# --- 3. CoM momentum correction ------------------------------------------------
# A drifting center of mass adds a spurious convective term to the heat flux.
# Zero the total linear momentum once, then keep it near zero during the NVE
# run. NOTE: only LINEAR momentum is corrected - removing net ANGULAR momentum
# every 100 steps would drain rotational kinetic energy and cool a small
# (1200-bead) system, making the NVE run non-stationary.
velocity        all zero linear
fix             1 all nve
fix             mom all momentum 100 linear 1 1 1

# --- 4. per-atom energy and virial, then the heat-flux vector -----------------
compute         myKE all ke/atom
compute         myPE all pe/atom
compute         myStress all stress/atom NULL virial
compute         flux all heat/flux myKE myPE myStress

# --- 5. raw heat-flux time series (independent verification source) -----------
variable        Jx equal c_flux[1]
variable        Jy equal c_flux[2]
variable        Jz equal c_flux[3]
variable        tstep equal step
fix             jout all print 5 "${tstep} ${Jx} ${Jy} ${Jz}" &
                file flux_${suffix}.dat screen no title "# step Jx Jy Jz"

# --- 6. heat-flux autocorrelation (HCACF) --------------------------------------
# Nevery=5 (dt*5 = 0.025 tau), Nrepeat=200 (window 5 tau), Nfreq=25000:
# 8 independent blocks in a 200000-step production run (ave one).
fix             JJ all ave/correlate 5 200 25000 &
                c_flux[1] c_flux[2] c_flux[3] &
                type auto file J0Jt_${suffix}.dat ave one

# --- 7. production --------------------------------------------------------------
run             200000
