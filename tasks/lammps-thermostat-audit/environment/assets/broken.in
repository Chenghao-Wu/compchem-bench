# LAMMPS NVT run with a temperature problem — CompChemBench lammps-thermostat-audit
# Intended physics: 3D LJ fluid (500 atoms, rho*=0.8442), NVT at T*=1.2,
# 5000 steps. Something is wrong with the temperature control.

units           lj
atom_style      atomic
dimension       3
boundary        p p p

lattice         fcc 0.8442
region          box block 0 5 0 5 0 5
create_box      2 box
create_atoms    1 box

# Split into two (physically identical) types
set             group all type/fraction 2 0.5 48293

mass            1 1.0
mass            2 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
pair_coeff      1 2 1.0 1.0 2.5
pair_coeff      2 2 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

velocity        all create 1.2 2718 loop geom

timestep        0.015

thermo          100
thermo_style    custom step temp pe etotal

# Thermostat the "mobile" particles to hold the fluid at T*=1.2
group           mobile type 1
fix             1 mobile nvt temp 1.2 1.2 0.5

run             5000
