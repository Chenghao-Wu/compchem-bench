# LAMMPS LJ melt input — CompChemBench lammps-lj-melt
# Reduced LJ units: epsilon=1, sigma=1, mass=1

units           lj
atom_style      atomic
dimension       3
boundary        p p p

# Create FCC lattice at density ~0.8
lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box

mass            1 1.0

# LJ pair style with cutoff 2.5 sigma
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# Neighbor list
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

# Initial velocity — fixed seed for reproducibility
velocity        all create 1.44 87287 loop geom

# Output thermodynamics every 100 steps
thermo          100
thermo_style    custom step temp pe etotal press

# NVE ensemble
fix             1 all nve

# Run 5000 steps
run             5000
