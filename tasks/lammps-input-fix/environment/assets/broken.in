# LAMMPS input with THREE errors — CompChemBench lammps-input-fix
# Intended physics: 3D Lennard-Jones fluid (epsilon=1, sigma=1, mass=1),
# FCC lattice at density 0.8442, NVE dynamics for 1000 steps, thermo every 100.

units           lj
atom_style      atomic
dimension       3
boundary        p p p

lattice         fcc 0.8442
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box

pair_styl       lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

velocity        all create 1.2 12345 loop geom

thermo          100
thermo_styl     custom step temp pe

fix             1 all nve
run             1000
