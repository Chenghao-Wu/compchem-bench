&CONTROL
  calculation = 'relax'
  prefix = 'pwscf'
  outdir = './outdir'
  pseudo_dir = './pseudo'
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav = 1
  celldm(1) = 20.0
  nat = 2
  ntyp = 2
  ecutwfc = 50.0
  ecutrho = 400.0
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
/
&ELECTRONS
  conv_thr = 1.0d-9
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  C 12.0107 C.pbe-n-kjpaw_psl.1.0.0.UPF
  O 15.9994 O.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS angstrom
  C 0.0 0.0 0.0
  O 0.0 0.0 1.25
K_POINTS gamma
